DATABASE_URL="postgresql://user:password@localhost:5432/ezpost_itmatt?schema=public"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ITMATT 走非會員免登入流程，不需保管任何 ITMATT 帳密。
ITMATT_BASE_URL="https://ezpost.post.gov.tw/itmatt/"

# LINE Messaging API（於 https://developers.line.biz 建立 channel 後取得）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
# 所有 LINE 客人的寄件單掛在此商家帳號下（後台註冊的 email）；留空則用第一個使用者
MERCHANT_USER_EMAIL=""

# Claude API：設定後 LINE bot 會用 LLM 聽懂自然語言（留空則退回固定腳本引導）
ANTHROPIC_API_KEY=""
# 可選：覆寫對話用的模型（預設 claude-opus-5）
LINE_AI_MODEL=""

# 送件模式：test=回傳示範 QR 不碰中華郵政（預設，安全）；live=用 Playwright 真送（會建立真實記錄，需先 npx playwright install chromium）
ITMATT_SUBMIT_MODE="test"
# 對外圖片網址（LINE 要能抓到 QR 圖）＝你的 cloudflared 通道網址，例：https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=""
